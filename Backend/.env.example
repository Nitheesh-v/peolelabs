# Keep secrets in Backend/.env or your deployment secret manager. Never commit .env.
# Applications are always stored under Backend/applications/ (git-ignored).
# Email delivery to the hiring team is optional and only used when all required mail settings below are configured.
CAREERS_EMAIL=
CAREERS_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Comma-separated extra origins allowed for CORS (the deployed Vercel app and
# localhost are always allowed).
CORS_ORIGINS=

# Existing MongoDB placeholders (not used by the current API server).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
