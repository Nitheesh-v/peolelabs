# Keep secrets in Backend/.env or your deployment secret manager. Never commit .env.
# Careers application emails are sent only when all required mail settings are configured.
CAREERS_EMAIL=
CAREERS_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Existing MongoDB placeholders (not used by the current API server).
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=
